# Copy to ".env" on the SERVER and fill every value. Never commit or share the real .env file.
ASSESS_DOMAIN=assess.mindbridgex.in
DB_USERNAME=assess
DB_PASSWORD=CHANGE_ME
APP_JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=you@yourdomain.com
SUPERADMIN_PASSWORD=CHANGE_ME
# Keep false in production. Set true only on a throw-away demo server to load sample colleges, students and exams.
SEED_DEMO=false
APP_TIMEZONE=Asia/Kolkata
