# Copy to /etc/assessment/assessment.env on the SERVER and fill every CHANGE_ME. Never share this file.
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/assessment
DB_USERNAME=assess
DB_PASSWORD=CHANGE_ME
APP_JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=you@yourdomain.com
SUPERADMIN_PASSWORD=CHANGE_ME
SEED_DEMO=false
COOKIE_SECURE=true
APP_TIMEZONE=Asia/Kolkata
STORAGE_DIR=/var/lib/assessment/uploads
