# Copy to .env and edit. NEVER commit .env.
DB_PASSWORD=change-me-strong-password
# At least 32 random characters:  openssl rand -base64 48
APP_JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Admin@123
# true loads demo teacher/students/questions/exam (never in real production)
SEED_DEMO=false
# Set to false ONLY when serving over plain HTTP (e.g. local testing)
COOKIE_SECURE=true
APP_TIMEZONE=Asia/Kolkata
HTTP_PORT=8080
